# PostgreSQL connection string (pooled). Created by the Vercel Neon integration.
# Pull it locally with: vercel env pull .env.local
# A database on this machine (localhost) also works, for local development.
DATABASE_URL=

# Google Gemini API key (server only, never expose to the browser).
GEMINI_API_KEY=
# Gemini model used for spending advice.
GEMINI_MODEL=gemini-3.5-flash-lite

# Long random string used to sign session cookies. Generate with: openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=
# The public address of the app, for example https://expenses.example.com
# Leave blank for local development (http://localhost:3000). On Vercel previews it
# falls back to the deployment address.
BETTER_AUTH_URL=
# Optional. Comma separated emails that may register, for example: me@example.com, friend@example.com
# Leave blank to let anyone register.
ALLOWED_EMAILS=
